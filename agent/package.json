{
  "name": "dalil-ra9mana-agent",
  "version": "1.0.0",
  "description": "Dalil Ra9mana school management desktop agent for Windows",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "34.0.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dz.dalilra9mana.agent",
    "productName": "Dalil Ra9mana Agent",
    "artifactName": "DalilRa9manaAgent-Setup.${ext}",
    "copyright": "Dalil Ra9mana",
    "directories": {
      "output": "dist"
    },
    "files": ["src/**/*", "assets/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
